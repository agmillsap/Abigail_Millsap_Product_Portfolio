'}};
const CACHE={};
async function unpack(b64){if(!('DecompressionStream' in window))throw new Error('gzip unsupported');const raw=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));const ds=new DecompressionStream('gzip');const stream=new Blob([raw]).stream().pipeThrough(ds);return await new Response(stream).text()}
async function getDemo(key){if(CACHE[key])return CACHE[key];CACHE[key]=await unpack(PACKED[key].data);return CACHE[key]}const FALLBACK={field:'field-sales-portfolio-demo.html',market:'market-opportunity-demo.html'};
let activeDemo=null;
async function openDemo(key){const d=PACKED[key];if(!d)return;activeDemo=key;document.getElementById('demoTitle').textContent=d.title;document.getElementById('demoShell').classList.add('open');document.body.classList.add('demo-open');document.getElementById('demoFrame').srcdoc='<style>body{font-family:Arial;padding:30px}</style><p>Loading interactive demo…</p>';try{document.getElementById('demoFrame').srcdoc=await getDemo(key)}catch(err){document.getElementById('demoFrame').srcdoc='';document.getElementById('demoFrame').src=FALLBACK[key]}history.replaceState(null,'','#'+key+'-demo')}
function closeDemo(){document.getElementById('demoShell').classList.remove('open');document.body.classList.remove('demo-open');document.getElementById('demoFrame').srcdoc='';document.getElementById('demoFrame').removeAttribute('src');activeDemo=null;history.replaceState(null,'',location.pathname+location.search+'#work')}
document.querySelectorAll('[data-demo]').forEach(el=>el.addEventListener('click',e=>{e.preventDefault();openDemo(el.dataset.demo)}));document.getElementById('demoBack').onclick=closeDemo;document.getElementById('demoNew').onclick=async()=>{if(!activeDemo)return;const html=await getDemo(activeDemo),blob=new Blob([html],{type:'text/html'}),url=URL.createObjectURL(blob);window.open(url,'_blank');setTimeout(()=>URL.revokeObjectURL(url),60000)};window.addEventListener('keydown',e=>{if(e.key==='Escape'&&activeDemo)closeDemo()});
async function initPreviews(){for(const f of document.querySelectorAll('[data-preview]')){const key=f.dataset.preview;try{f.srcdoc=await getDemo(key)}catch(err){f.src=FALLBACK[key]}const load=f.previousElementSibling;if(load)load.remove()}scalePreviews()}
function scalePreviews(){document.querySelectorAll('.previewViewport').forEach(v=>{const f=v.querySelector('.previewFrame');if(f)f.style.transform=`scale(${v.clientWidth/1600})`})}
window.addEventListener('resize',scalePreviews);initPreviews();if(location.hash==='#field-demo')openDemo('field');if(location.hash==='#market-demo')openDemo('market');
</script>
</body></html>